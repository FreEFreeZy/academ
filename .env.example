# Database
DB_DRIVER=asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO_SQL=true

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production
APP_CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO